# Copy to .env (or .env.local) and adjust. Never commit real secrets.
# Next.js sets NODE_ENV itself (development for `yarn dev`, production for `yarn build`).

NEXT_APP_TOKEN_NAME="__hogan_admin_token"
NEXT_APP_PROJECT_NAME="hogan-admin"

# Backend API (local backend: http://localhost:1988)
NEXT_APP_BASE_URL="https://hogan-jets-api.dedicateddevelopers.us"

# Media CDN
NEXT_APP_MEDIA_BASE_URL="https://d2l43jltela1or.cloudfront.net"

# This admin panel's own URL (used in password-reset links)
NEXT_APP_FRONTEND_BASE_URL="http://localhost:14596"

# Public website
NEXT_APP_MAIN_WEBSITE_URL="https://hogan-jets-dev.dedicateddevelopers.us"

# Web push (public VAPID key only; the private key belongs on the backend)
WEB_PUSH_KEY_PUBLIC=
